# Calendae — Configuration générale (docker-compose)

# ── Sécurité (obligatoire en production) ──
SECRET_KEY=changeme-in-production

# ── CORS (domaine du frontend, séparé par des virgules si plusieurs) ──
CORS_ORIGINS=http://localhost:3000

# ── API (URL de l'API backend vue par le navigateur) ──
API_URL=http://localhost:8000

# ── Feature Flags ──
FEATURE_BUFFER_TIMES=true
FEATURE_MIN_NOTICE=true
FEATURE_MAX_BOOKINGS=true
FEATURE_ROUND_ROBIN=false
FEATURE_COLLECTIVE=false
FEATURE_WEBHOOKS=false
FEATURE_PAYMENTS=false
FEATURE_TIMEZONE_DETECTION=true
FEATURE_VIDEO_CONFERENCING=true

# ── Stripe (uniquement si FEATURE_PAYMENTS=true) ──
STRIPE_WEBHOOK_SECRET=

# ── Google Calendar (synchronisation) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
