# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/calendae

# ── Security ──
SECRET_KEY=changeme-in-production

# ── Feature Flags ──
# Le frontend adapte l'UI automatiquement selon ces flags

# Temps de tampon avant/après chaque rendez-vous
FEATURE_BUFFER_TIMES=true

# Délai de prévenance minimum avant réservation
FEATURE_MIN_NOTICE=true

# Limite de réservations par jour par collaborateur
FEATURE_MAX_BOOKINGS=true

# Distribution round-robin (assignation automatique au membre le moins chargé)
FEATURE_ROUND_ROBIN=false

# Réservation collective (tous les membres doivent être disponibles)
FEATURE_COLLECTIVE=false

# Webhooks (envoi POST sur booking.created / booking.cancelled)
FEATURE_WEBHOOKS=false

# Paiement Stripe à la réservation
FEATURE_PAYMENTS=false

# Détection et affichage du fuseau horaire
FEATURE_TIMEZONE_DETECTION=true

# ── Stripe (uniquement si FEATURE_PAYMENTS=true) ──
STRIPE_WEBHOOK_SECRET=
